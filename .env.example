# ──────────────────────────────────────────────
# OneAtlas — Environment Variables
# ──────────────────────────────────────────────

# PostgreSQL connection string (required for live DB mode)
# If not set, the app falls back to the in-memory data repository
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/oneatlas?schema=public"

# Optional: Sync admin secret (protects POST /api/v1/sync)
SYNC_SECRET="change-this-to-a-secure-secret"

# Next.js public URL for Open Graph & canonical links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
